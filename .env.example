# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
GOOGLE_SAFE_BROWSING_API_KEY=
GOOGLE_WEB_RISK_API_KEY=
VIRUSTOTAL_API_KEY=
REPUTATION_SECONDARY_ENABLED=true
REPUTATION_MAX_NETWORK_CALLS=4
GOOGLE_FACT_CHECK_API_KEY=
TAVILY_API_KEY=
REPUTATION_MAX_ATTEMPTS=2
REPUTATION_CIRCUIT_FAILURE_THRESHOLD=3
REPUTATION_SECONDARY_CALL_BUDGET=1
SECURITY_INVESTIGATION_MAX_EXTERNAL_CALLS=8
SECURITY_INVESTIGATION_MAX_RETRIES=1
SECURITY_INVESTIGATION_DEADLINE_SECONDS=20
OFFICIAL_VERIFIER_API_URL=
OFFICIAL_VERIFIER_API_KEY=
SECURITY_CONVERSATION_RETENTION_DAYS=30
# Keep pre_cutover until hosted evaluation, restore rehearsal, and the
# compatibility window pass. The cutover profile freezes legacy writes.
SECURITY_RELEASE_PROFILE=pre_cutover
LEGACY_API_WRITES_ENABLED=true
PROVIDER_TIMEOUT_SECONDS=10
# When true, Security v4 requires Web Risk, the official verifier, and
# VirusTotal when the secondary reputation adapter is enabled. Legacy Google
# Fact Check/Tavily/OpenAI keys are not part of this readiness profile.
LIVE_PROVIDERS_REQUIRED=false
ANALYSIS_DEADLINE_SECONDS=30
FACT_CHECK_TIMEOUT_SECONDS=30
POST_PROCESSING_RESERVE_SECONDS=10
MAX_PROVIDER_COST_USD=0.05
MAX_CLAIM_CONCURRENCY=3
SOURCE_DISCOVERY_ENABLED=true
SOURCE_PROVISIONAL_ENABLED=true
SOURCE_AUTO_PROMOTION_ENABLED=true
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
DATABASE_ENCRYPTION_KEY=replace-with-a-long-random-secret
SECURITY_DATABASE_PATH=./data/security.db
REDIS_URL=redis://localhost:6379/0
# For PostgreSQL production/Wave 1:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_NAME=TrustGuard AI
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Demo Auth (development/test only) ----
# Production also requires PostgreSQL, Redis, explicit HTTPS CORS origins,
# HTTPS OIDC, and different non-placeholder encryption/signing keys (>=32 chars).
# Set DEMO_AUTH_ENABLED=false in production and integrate a real IdP.
DEMO_AUTH_ENABLED=true
DEMO_USER_TOKEN=dev-user-token
DEMO_ADMIN_TOKEN=dev-admin-token
# Auth0/OIDC access-token validation (required when demo auth is disabled)
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=https://api.trustguard.example
# Optional; defaults to {OIDC_ISSUER}/.well-known/jwks.json
OIDC_JWKS_URL=
OIDC_ADMIN_ROLE=security_admin
OIDC_ROLES_CLAIM=roles
USER_RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=60
WEBSOCKET_TICKET_TTL_SECONDS=60
JOB_LEASE_SECONDS=60
RUN_DURABLE_WORKER=true
ARTIFACT_SIGNING_KEY=replace-with-a-separate-long-random-secret
ARTIFACT_ACCESS_TTL_SECONDS=300
ARTIFACT_RETENTION_DAYS=30
ARTIFACT_STORAGE_DIR=./data/artifacts

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Compose uses these values as frontend build arguments. Changes require
# rebuilding the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_REDIRECT_URI=
NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT=
NEXT_PUBLIC_OIDC_TOKEN_ENDPOINT=
NEXT_PUBLIC_OIDC_LOGOUT_URL=
NEXT_PUBLIC_OIDC_ROLES_CLAIM=roles
NEXT_PUBLIC_OIDC_ADMIN_ROLE=security_admin
NEXT_PUBLIC_OIDC_SCOPE=openid profile email offline_access
# Deprecated compatibility alias for NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT.
NEXT_PUBLIC_OIDC_LOGIN_URL=
# NEXT_PUBLIC_DEMO_USER_TOKEN=dev-user-token
# NEXT_PUBLIC_DEMO_ADMIN_TOKEN=dev-admin-token
