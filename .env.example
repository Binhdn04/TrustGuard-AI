# ============================================
# AI20K Project — Environment Variables
# ============================================
# Local Docker/development defaults. Copy this file to .env and fill in your values.
# Railway production uses service-scoped reference/shared variables documented in
# docs/RAILWAY_DEPLOYMENT.md; do not paste this file wholesale into production.
# NEVER commit .env to git!

# ---- LLM Configuration ----
# This committed template must contain placeholders only. Set real credentials
# in an ignored local .env or the deployment secret manager, never here.
OPENAI_API_KEY=
SECURITY_ASYNC_EXECUTION_ENABLED=false
SECURITY_MEMORY_RETRIEVAL_ENABLED=false
# Automatic, owner-scoped preview after a case result. Keep false unless Chromium
# runs with restricted egress; captures use no-store and are never persisted.
SECURITY_PAGE_CAPTURE_ENABLED=false
SECURITY_PAGE_CAPTURE_TIMEOUT_SECONDS=12
SECURITY_PAGE_CAPTURE_MAX_IMAGE_BYTES=2000000
SECURITY_PAGE_CAPTURE_MAX_CONCURRENCY=2
SECURITY_PAGE_CAPTURE_VIEWPORT_WIDTH=1280
SECURITY_PAGE_CAPTURE_VIEWPORT_HEIGHT=720
SECURITY_PAGE_CAPTURE_JPEG_QUALITY=72
# Official-link rollout: off | shadow | visible | enforced.
# Tavily is optional; local reviewed identities still work without it.
SECURITY_OFFICIAL_VERIFICATION_MODE=visible
# Discovery uses bounded evidence frontiers; no query-expansion flag is required.
SECURITY_DOMAIN_FAMILIARITY_MODE=off
SECURITY_ADMIN_COPILOT_RATE_LIMIT_PER_MINUTE=5
SECURITY_AI_MAX_CALLS_PER_TURN=8
SECURITY_AI_TIMEOUT_SECONDS=15
SECURITY_AI_TURN_DEADLINE_SECONDS=60
SECURITY_AI_MAX_RETRIES=1
SECURITY_AI_SMALL_MODEL=gpt-4o-mini
SECURITY_AI_SYNTHESIS_MODEL=gpt-4o-mini
SECURITY_AI_SMALL_INPUT_COST_PER_MILLION_USD=0.15
SECURITY_AI_SMALL_OUTPUT_COST_PER_MILLION_USD=0.60
SECURITY_AI_SYNTHESIS_INPUT_COST_PER_MILLION_USD=0.15
SECURITY_AI_SYNTHESIS_OUTPUT_COST_PER_MILLION_USD=0.60
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
GOOGLE_SAFE_BROWSING_API_KEY=
VIRUSTOTAL_API_KEY=
BKNS_WHOIS_API_KEY=
CLOUDFLARE_RADAR_API_TOKEN=
REPUTATION_SECONDARY_ENABLED=true
REPUTATION_MAX_NETWORK_CALLS=4
TAVILY_API_KEY=
REPUTATION_MAX_ATTEMPTS=2
REPUTATION_CIRCUIT_FAILURE_THRESHOLD=3
REPUTATION_SECONDARY_CALL_BUDGET=1
SECURITY_INVESTIGATION_MAX_EXTERNAL_CALLS=16
SECURITY_INVESTIGATION_MAX_RETRIES=1
SECURITY_INVESTIGATION_DEADLINE_SECONDS=20
SECURITY_CONVERSATION_RETENTION_DAYS=30
# Keep pre_cutover until hosted evaluation and restore rehearsal pass.
SECURITY_RELEASE_PROFILE=pre_cutover
PROVIDER_TIMEOUT_SECONDS=10
# When true, Security v4 requires VirusTotal.
LIVE_PROVIDERS_REQUIRED=false
ANALYSIS_DEADLINE_SECONDS=60
POST_PROCESSING_RESERVE_SECONDS=10
MAX_PROVIDER_COST_USD=0.05
MAX_CLAIM_CONCURRENCY=3
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
DATABASE_ENCRYPTION_KEY=replace-with-a-long-random-secret
SECURITY_DATABASE_PATH=./data/security.db
REDIS_URL=redis://localhost:6379/0
# For PostgreSQL production/Wave 1:
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- App Config ----
APP_NAME=TrustGuard AI
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Keep extension origins separate from normal web origins. For local unpacked
# testing, put only the current exact runtime ID in your ignored .env, for
# example chrome-extension://<32-character-id>. Never use a wildcard.
CHROME_EXTENSION_ORIGINS=

# ---- Demo Auth (development/test only) ----
# Production also requires PostgreSQL, Redis, explicit HTTPS CORS origins,
# HTTPS OIDC, and different non-placeholder encryption/signing keys (>=32 chars).
# Set DEMO_AUTH_ENABLED=false in production and integrate a real IdP.
DEMO_AUTH_ENABLED=true
DEMO_USER_TOKEN=dev-user-token
DEMO_ADMIN_TOKEN=dev-admin-token
# Auth0/OIDC access-token validation (required when demo auth is disabled)
OIDC_ISSUER=https://your-tenant.auth0.com/
OIDC_AUDIENCE=https://api.trustguard.example
# Optional; defaults to {OIDC_ISSUER}/.well-known/jwks.json
OIDC_JWKS_URL=
OIDC_ADMIN_ROLE=security_admin
# Production Auth0 Action emits this namespaced claim in access and ID tokens.
OIDC_ROLES_CLAIM=https://api.trustguard.example/roles

USER_RATE_LIMIT_PER_MINUTE=120
ADMIN_RATE_LIMIT_PER_MINUTE=60
# Pre-authentication API limit, keyed by an HMAC of the source IP. Set
# TRUSTED_PROXY_IPS only to deployment-controlled proxy IPs/CIDRs before the
# app will accept their X-Forwarded-For header; leave empty for direct access.
IP_RATE_LIMIT_PER_MINUTE=240
TRUSTED_PROXY_IPS=
WEBSOCKET_TICKET_TTL_SECONDS=60
JOB_LEASE_SECONDS=60
RUN_DURABLE_WORKER=true
CONTENT_RETENTION_DAYS=30

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# Compose uses these values as frontend build arguments. Changes require
# rebuilding the frontend image.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OIDC_ISSUER=
NEXT_PUBLIC_OIDC_CLIENT_ID=
NEXT_PUBLIC_OIDC_AUDIENCE=
NEXT_PUBLIC_OIDC_REDIRECT_URI=
NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT=
NEXT_PUBLIC_OIDC_TOKEN_ENDPOINT=
NEXT_PUBLIC_OIDC_LOGOUT_URL=
NEXT_PUBLIC_OIDC_ROLES_CLAIM=https://api.trustguard.example/roles
NEXT_PUBLIC_OIDC_ADMIN_ROLE=security_admin
NEXT_PUBLIC_OIDC_SCOPE=openid profile email offline_access
# Deprecated compatibility alias for NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT.
NEXT_PUBLIC_OIDC_LOGIN_URL=
# NEXT_PUBLIC_DEMO_USER_TOKEN=dev-user-token
# NEXT_PUBLIC_DEMO_ADMIN_TOKEN=dev-admin-token

# ---- Railway production reference (do not uncomment for local use) ----
# Service names are fixed to: frontend, backend, worker, postgres, redis.
# Backend/worker:
# APP_ENV=production
# DEMO_AUTH_ENABLED=false
# DATABASE_URL=${{postgres.DATABASE_URL}}
# REDIS_URL=${{redis.REDIS_URL}}
# DATABASE_ENCRYPTION_KEY=${{shared.DATABASE_ENCRYPTION_KEY}}
# OIDC_ISSUER=${{shared.OIDC_ISSUER}}
# OIDC_AUDIENCE=${{shared.OIDC_AUDIENCE}}
# CORS_ORIGINS=https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}
# SECURITY_RELEASE_PROFILE=pre_cutover
# SECURITY_ASYNC_EXECUTION_ENABLED=false
# Backend only: RUN_DURABLE_WORKER=false
# Worker only: RUN_DURABLE_WORKER=true
# Frontend build variables:
# NEXT_PUBLIC_API_URL=https://${{backend.RAILWAY_PUBLIC_DOMAIN}}
# Never define NEXT_PUBLIC_DEMO_USER_TOKEN or NEXT_PUBLIC_DEMO_ADMIN_TOKEN in production.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="https://cloud.langfuse.com"
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_DEBUG=false
# When true, send content scrubbed for secrets, PII, and URL queries. Provider
# prompts/completions remain blocked at the export boundary.
LANGFUSE_CAPTURE_SANITIZED_CONTENT=false
# Client-side trace sampling: 1.0 sends every trace, 0.1 sends roughly 10%.
LANGFUSE_SAMPLE_RATE=1.0
