{
  "hooksConfig": {
    "enabled": true,
    "notifications": true
  },
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "name": "log-prompt",
            "type": "command",
            "command": "bash -lc 'repo_root=\"$(git rev-parse --show-toplevel)\" && AI_LOG_DIR=\"$repo_root/.ai-log\" bash \"$repo_root/scripts/_pyrun.sh\" \"$repo_root/scripts/log_hook.py\" --tool=gemini >/dev/null'",
            "commandWindows": "python scripts/log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "AfterModel": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-model",
            "type": "command",
            "command": "bash -lc 'repo_root=\"$(git rev-parse --show-toplevel)\" && AI_LOG_DIR=\"$repo_root/.ai-log\" bash \"$repo_root/scripts/_pyrun.sh\" \"$repo_root/scripts/log_hook.py\" --tool=gemini >/dev/null'",
            "commandWindows": "python scripts/log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "name": "log-session-end",
            "type": "command",
            "command": "bash -lc 'repo_root=\"$(git rev-parse --show-toplevel)\" && AI_LOG_DIR=\"$repo_root/.ai-log\" bash \"$repo_root/scripts/_pyrun.sh\" \"$repo_root/scripts/log_hook.py\" --tool=gemini >/dev/null'",
            "commandWindows": "python scripts/log_hook.py --tool=gemini",
            "timeout": 10000
          }
        ]
      }
    ]
  }
}
