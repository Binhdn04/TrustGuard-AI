NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=false

# Hosted deployments provide an OIDC login entrypoint and must not define
# demo tokens.
# NEXT_PUBLIC_OIDC_LOGIN_URL=https://your-tenant.auth0.com/authorize?...

# Local development only:
# NEXT_PUBLIC_DEMO_USER_TOKEN=dev-user-token
# NEXT_PUBLIC_DEMO_ADMIN_TOKEN=dev-admin-token
