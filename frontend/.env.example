NEXT_PUBLIC_API_URL=http://localhost:8000

# Hosted deployments use Authorization Code + PKCE and must not define demo
# tokens. Issuer/client ID are required; endpoint overrides are optional.
# NEXT_PUBLIC_OIDC_ISSUER=https://your-tenant.auth0.com/
# NEXT_PUBLIC_OIDC_CLIENT_ID=your-public-spa-client-id
# NEXT_PUBLIC_OIDC_AUDIENCE=https://api.trustguard.example
# NEXT_PUBLIC_OIDC_REDIRECT_URI=https://app.trustguard.example/auth/callback
# NEXT_PUBLIC_OIDC_AUTHORIZATION_ENDPOINT=https://your-tenant.auth0.com/authorize
# NEXT_PUBLIC_OIDC_TOKEN_ENDPOINT=https://your-tenant.auth0.com/oauth/token
# NEXT_PUBLIC_OIDC_LOGOUT_URL=https://your-tenant.auth0.com/v2/logout?client_id=...&returnTo=...
# NEXT_PUBLIC_OIDC_ROLES_CLAIM=roles
# NEXT_PUBLIC_OIDC_ADMIN_ROLE=security_admin
# NEXT_PUBLIC_OIDC_SCOPE=openid profile email offline_access
# Deprecated compatibility alias for the authorization endpoint:
# NEXT_PUBLIC_OIDC_LOGIN_URL=https://your-tenant.auth0.com/authorize

# Local development only:
# NEXT_PUBLIC_DEMO_USER_TOKEN=dev-user-token
# NEXT_PUBLIC_DEMO_ADMIN_TOKEN=dev-admin-token
