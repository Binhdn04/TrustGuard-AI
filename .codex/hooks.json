{
  "description": "Automatically capture Codex prompts and turn completions.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'repo_root=\"$(git rev-parse --show-toplevel)\" && AI_LOG_DIR=\"$repo_root/.ai-log\" bash \"$repo_root/scripts/_pyrun.sh\" \"$repo_root/scripts/log_hook.py\" --tool=codex >/dev/null'",
            "commandWindows": "python scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'repo_root=\"$(git rev-parse --show-toplevel)\" && AI_LOG_DIR=\"$repo_root/.ai-log\" bash \"$repo_root/scripts/_pyrun.sh\" \"$repo_root/scripts/log_hook.py\" --tool=codex >/dev/null'",
            "commandWindows": "python scripts/log_hook.py --tool=codex",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
