# Copy to .env.local. Never commit the local file or an unpacked extension ID.
# Register chrome.identity.getRedirectURL("oidc") from the loaded extension as
# the exact callback URI of a separate OIDC public client. Do not use a secret.
VITE_TRUSTGUARD_API_URL=http://localhost:8000
VITE_OIDC_ISSUER=https://your-tenant.auth0.com/
VITE_OIDC_CLIENT_ID=your-extension-public-client-id
VITE_OIDC_AUDIENCE=https://api.trustguard.example
VITE_OIDC_AUTHORIZATION_ENDPOINT=https://your-tenant.auth0.com/authorize
VITE_OIDC_TOKEN_ENDPOINT=https://your-tenant.auth0.com/oauth/token
VITE_OIDC_REVOCATION_ENDPOINT=https://your-tenant.auth0.com/oauth/revoke
VITE_OIDC_ROLES_CLAIM=https://api.trustguard.example/roles
VITE_OIDC_ADMIN_ROLE=security_admin
VITE_OIDC_SCOPE=openid profile email offline_access
